{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "DATABASE_URL": {
          "dev": "sqlite:///./wardrobe.db"
        },
        "UPLOAD_DIR": {
          "dev": "./uploads"
        },
        "FRONTEND_ORIGIN": {
          "dev": "${service:frontend.origin}"
        }
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        ["npm", "ci"]
      ],
      "build": [
        ["npm", "run", "build"]
      ],
      "start": [
        "node",
        "./node_modules/vite/bin/vite.js",
        "--port",
        "${PORT}",
        "--host"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "VITE_API_URL": {
          "dev": "${service:api.origin}"
        }
      }
    }
  ]
}

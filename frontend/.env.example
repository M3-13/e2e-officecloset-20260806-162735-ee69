# API base URL of the backend service.
# The run runner injects this via "${service:api.origin}" (see RUN.json), so in a
# managed environment you usually do not need this file at all. It only exists for
# a plain `npm run dev` against a locally started backend. Leave it out to use the
# default in src/api/client.ts.
VITE_API_URL=http://localhost:8000
# Backend environment variables for local development.
# RUN.json declares these; the runner injects them automatically.
# Copy this file to .env and fill in the values before starting manually.

# JWT signing key — generate one yourself (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=<generate-a-random-hex-secret-64-chars>

# Database URL (default: sqlite:///./dev.db)
DATABASE_URL=sqlite:///./dev.db

# Upload directory for clothing images (default: ./uploads)
UPLOAD_DIR=./uploads

# Frontend origin for CORS (when running the frontend separately)
FRONTEND_ORIGIN=http://localhost:5173

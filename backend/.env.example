# Backend environment — copy to .env and set the values.

# Database URL (default: SQLite in the project directory)
DATABASE_URL=sqlite:///./dev.db

# Upload directory for clothing item images
UPLOAD_DIR=./uploads

# JWT signing key — generate with: py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-a-32-byte-hex-secret-here>

# Frontend origin for CORS (set to the Vite dev server URL, e.g. http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

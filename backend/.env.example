# Backend environment variables
#
# In a managed run (CI / Tessa) these are injected from RUN.json — you normally do
# not need this file. It only exists so you can start the backend by hand for
# local development.
#
# Copy this file to .env and fill in the values before running:
#   cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000

# SQLite database path (default: sqlite:///./dev.db)
DATABASE_URL=sqlite:///./dev.db

# Directory for uploaded images (default: ./uploads)
UPLOAD_DIR=./uploads

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-random-hex-string

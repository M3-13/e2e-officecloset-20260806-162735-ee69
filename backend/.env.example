# Copy this file to .env and fill in the values.
# Values marked as "generate" in RUN.json are rolled per start.
# Run the product once — the runner will generate them or you can roll your own.

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection URL
DATABASE_URL=sqlite:///./wardrobe.db

# Directory for uploaded images
UPLOAD_DIR=./uploads

# Allowed CORS origin (set to your frontend dev server URL)
FRONTEND_ORIGIN=http://localhost:5173
